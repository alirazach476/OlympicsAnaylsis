# Application
APP_ENV=development
LOG_LEVEL=INFO
PROJECT_ROOT=.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olympics
POSTGRES_USER=olympics
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg2://olympics:change_me@localhost:5432/olympics

# Wikipedia / MediaWiki
WIKI_API_URL=https://en.wikipedia.org/w/api.php
WIKI_USER_AGENT=OlympicsHistoricalCollector/1.0 (research; contact: local-dev@example.com)
WIKI_REQUEST_DELAY_SECONDS=0.5
WIKI_MAXLAG_SECONDS=5
WIKI_MAX_RETRIES=5
WIKI_CACHE_DIR=data/raw/wikipedia/cache

# Crawler defaults
CRAWL_MAX_DEPTH=3
CRAWL_MAX_PAGES_PER_EDITION=500
CRAWL_MIN_RELEVANCE_SCORE=0.45
CRAWL_PAUSE_FILE=data/raw/wikipedia/.crawl_paused
CRAWL_CHECKPOINT_EVERY=1

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Assets
ASSETS_ROOT=assets
DOWNLOAD_IMAGES=false
